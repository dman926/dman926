---
layout: base.njk
title: 404 · Page not found
permalink: 404.html
eleventyExcludeFromCollections: true
---
{% set prompt %}<span class="prompt-user">dennis</span><span class="prompt-symbol">@</span><span
  class="prompt-host">portfolio</span><span class="prompt-symbol">&nbsp;~ %&nbsp;</span>{% endset %}

<main class="not-found">
  <div class="terminal">
    <div class="terminal-dots">
      <div class="terminal-dot"></div>
      <div class="terminal-dot"></div>
      <div class="terminal-dot"></div>
    </div>

    <div class="terminal-body">
      <div class="prompt-line">{{ prompt | safe }}<span class="prompt-cmd" id="nf-cmd">cat that-page</span></div>
      <div class="output-line error" id="nf-error">cat: that-page: No such file</div>

      <div class="prompt-line">{{ prompt | safe }}<span class="prompt-cmd">echo $?</span></div>
      <div class="output-line error-code">404</div>
      <div class="output-line dim">This page doesn't exist, or it moved.</div>

      <div class="prompt-line">{{ prompt | safe }}<span class="prompt-cmd">cd ~</span></div>
      <div class="output-line cmd-name"><a href="/">&larr; Back to the portfolio</a></div>
    </div>

    <div class="terminal-input">
      {{ prompt | safe }}
      <input type="text" id="nf-input" autocomplete="off" spellcheck="false" autofocus aria-label="Terminal input">
    </div>
  </div>
</main>

<script>
  // Echo the path that was actually requested. textContent keeps it injection-safe.
  (() => {
    const path = location.pathname;
    document.getElementById('nf-cmd').textContent = 'cat ' + path;
    document.getElementById('nf-error').textContent = `cat: ${path}: No such file`;

    const input = document.getElementById('nf-input');
    document.querySelector('.not-found .terminal').addEventListener('click', () => input.focus());
    input.addEventListener('keydown', (e) => {
      if (e.key == 'Enter' && /^cd(\s+~|\s+\/)?$/.test(input.value.trim())) location.href = '/'
    })
  })();
</script>