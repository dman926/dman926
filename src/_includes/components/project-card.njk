{% macro projectCard(project) %}
<div class="project-card reveal" data-categories="{{ project.categories }}">
  <!-- Card preview trigger -->
  <a href="#project-{{ project.id }}" class="card-trigger">
    <h3 class="project-title">{{ project.title }}</h3>
    <p class="project-subtitle">{{ project.subtitle }}</p>
    <p class="project-desc">{{ project.description }}</p>
    <div class="project-tags">
      {% for tag in project.tags %}
      <span class="tag">{{ tag }}</span>
      {% endfor %}
    </div>
  </a>
</div>

<div id="project-{{ project.id }}" class="project-overlay">
  <div class="overlay-content" role="dialog" aria-modal="true" aria-labelledby="project-{{ project.id }}-title">
    <a href="#" class="overlay-close-btn">← Back to projects</a>

    <h2 class="project-title" id="project-{{ project.id }}-title"
      style="font-size: 1.5rem; margin-top: 1rem; margin-bottom: 0.25rem;">{{ project.title }}</h2>
    <p class="project-subtitle">{{ project.subtitle }}</p>
    <p class="project-desc" style="margin-bottom: 1.5rem;">{{ project.description }}</p>

    <div class="project-tags" style="margin-bottom: 1.5rem;">
      {% for tag in project.tags %}
      <span class="tag">{{ tag }}</span>
      {% endfor %}
    </div>

    <div class="metrics-row">
      {% for metric in project.metrics %}
      <div class="metric">
        <div class="metric-value">{{ metric.value }}</div>
        <div class="metric-label">{{ metric.label }}</div>
      </div>
      {% endfor %}
    </div>

    {% for detail in project.details %}
    <div class="detail-section" style="margin-top: 1.5rem;">
      <div class="detail-label">{{ detail.label }}</div>
      {% if detail.text %}
      <p class="detail-text">{{ detail.text | safe }}</p>
      {% endif %}
      {% if detail.code %}
      <div class="detail-code">
        {% highlight detail.lang %}
        {{ detail.code | safe }}
        {% endhighlight %}
      </div>
      {% endif %}
    </div>
    {% endfor %}

    {% if project.models %}
    <div class="detail-section" style="margin-top: 1.5rem;">
      <div class="detail-label">Models</div>
      <div class="model-list">
        {% for model in project.models %}
        <article class="model">
          <div class="model-head">
            <h3 class="model-name">{{ model.name }}</h3>
            {% if model.material %}<span class="tag">{{ model.material }}</span>{% endif %}
          </div>
          <p class="detail-text">{{ model.description | safe }}</p>

          {% if model.preview %}
          <button type="button" class="model-preview-btn" aria-expanded="false">Preview 3D</button>
          <div class="model-viewer" data-src="{{ model.preview | join('|') }}" hidden></div>
          {% endif %}

          <ul class="file-list">
            {% for file in model.files %}
            <li>
              <a href="{{ file.path }}" download>{{ file.label }}</a>
              <span class="file-meta">{{ file.note }}{{ " · " if file.note }}{{ file.path | fileSize }}</span>
            </li>
            {% endfor %}
          </ul>
        </article>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if project.externalLink %}
    <a class="overlay-external-link-btn" href="{{ project.externalLink.url }}" target="_blank"
      rel="noopener noreferrer">
      {{ project.externalLink.label }}
    </a>
    {% endif %}
  </div>
</div>
{% endmacro %}